<?xml version="1.0" encoding="utf-8"?>
<widget id="mendix.dockpane.DockPane" pluginWidget="true" needsEntityContext="true" offlineCapable="true"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Dock Pane</name>
    <description>My widget description</description>
    <icon>
        
    </icon>
    <properties>
        <propertyGroup caption="General">
            <property key="positionKey" type="attribute" required="false">
                <caption>Position of the dock pane</caption>
                <description>TSide to dock (left, right, top or bottom). Default is left.</description>
                <!-- <prompt>Position of the dock pane</prompt> -->
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>
            <property key="isVisibleKey" type="attribute" required="false">
                <caption>is dock pane visible</caption>
                <description>Default is true.</description>
                <!-- <prompt>Visibility of the dock pane</prompt> -->
                <attributeTypes>
                    <attributeType name="Boolean"/>
                </attributeTypes>
            </property>

            <property key="dimmodeKey" type="attribute" required="false">
                <caption>Dim Mode</caption>
                <description>If none - content is not dimmed, if transparent - pointer events are disabled (so you can click through it), if opaque - click on dim area closes the dock. Default is opaque</description>
                <!-- <prompt>Dim Mode</prompt> -->
                <attributeTypes>
                    <attributeType name="String"/>
                </attributeTypes>
            </property>
             <property key="sizeKey" type="attribute" required="false">
                <caption>size</caption>
                <description>Size of dock pane.Set fluid to true to resize proportionally on window resize.</description>
                <!-- <prompt>Size of the dock pane</prompt> -->
                <attributeTypes>
                    <attributeType name="Integer"/>
                    <attributeType name="Decimal"/>
                </attributeTypes>
            </property>

            <property key="zIndexKey" type="attribute" required="false">
                <caption>zIndex</caption>
                <description>zIndex of dock pane</description>
                <!-- <prompt>zIndex of the dock pane</prompt> -->
                <attributeTypes>
                    <attributeType name="Integer"/>
                    <attributeType name="Decimal"/>
                </attributeTypes>
            </property>

            <property key="fluidKey" type="attribute" required="false">
                <caption>Fluid</caption>
                <description>If true, resize dock proportionally on window resize.</description>
                <!-- <prompt>Fluid of the dock pane</prompt> -->
                <attributeTypes>
                    <attributeType name="Boolean"/>
                </attributeTypes>
            </property>

            <property key="contentKey" type="widgets" required="false">
	        <caption>Content</caption>
	        <description>Content of the dock pane</description>
            <!-- <prompt>Content of the dock pane</prompt> -->
            </property>
            

        </propertyGroup>
        
        <propertyGroup caption="Events">
            <property key="onClickAction" type="action" required="false">
                <caption>On click action</caption>
                <description>Action to trigger when button / label is clicked</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
